# Database
DB_USER=blogger
DB_PASSWORD=change_me_to_secure_password
DB_NAME=blogger_db
DB_HOST=db
DB_PORT=5432

# Backend
PORT=3000
NODE_ENV=development
JWT_SECRET=change_me_to_random_string

# Ports (host mapping)
BACKEND_PORT=3000

# Base URL for sitemap/robots.txt generation
# REQUIRED in production: set to your actual domain (e.g., https://yourblog.com)
# Used by SEO endpoints to generate absolute URLs in sitemap.xml and robots.txt
BASE_URL=http://localhost:4000